{
  "openapi": "3.1.0",
  "info": {
    "title": "Fail2ban observations API",
    "version": "1.0.0",
    "description": "Snapshot observations from Fail2ban sources. A recorded IP is not proof of malicious activity. Timestamps are collection times, not exact BAN-event times.",
    "license": {
      "name": "BSD-2-Clause",
      "identifier": "BSD-2-Clause"
    }
  },
  "servers": [
    {
      "url": "https://api.f2b.0xhw.com",
      "description": "Public read API"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Service metadata",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidQuery"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "operationId": "getHealth",
        "tags": ["Public API"]
      }
    },
    "/v1/lookup": {
      "get": {
        "summary": "IP observations including inactive and stale records",
        "parameters": [
          {
            "name": "ip",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Public IPv4 or IPv6 address. Private and reserved addresses are rejected; IPv4-mapped IPv6 is normalized.",
            "example": "1.1.1.1"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lookup"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidQuery"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "operationId": "lookupIP",
        "tags": ["Public API"]
      }
    },
    "/v1/ips": {
      "get": {
        "summary": "Paged observations with filters, sorting and cursor pagination",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 2048
            },
            "description": "Opaque cursor from next_cursor or X-Next-Cursor. It is bound to the filters and sort; reuse with different conditions returns 400."
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
            }
          },
          {
            "name": "jail",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          {
            "name": "asn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          },
          {
            "name": "active",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["true", "false", "all"],
              "default": "true"
            },
            "description": "true: fresh active observations; false: inactive observations; all: full history including stale sources."
          },
          {
            "name": "stale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["true", "false"]
            },
            "description": "true only for sources whose last collection is older than the stale threshold."
          },
          {
            "name": "ip_prefix",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[0-9a-fA-F:.]+$"
            },
            "description": "Text prefix match on the canonical IP address."
          },
          {
            "name": "organization",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "Case-insensitive substring match on the organization name."
          },
          {
            "name": "first_seen_from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000000
            },
            "description": "Unix seconds; inclusive lower bound."
          },
          {
            "name": "first_seen_to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000000
            },
            "description": "Unix seconds; inclusive upper bound."
          },
          {
            "name": "last_seen_from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000000
            },
            "description": "Unix seconds; inclusive lower bound on the effective last-seen time."
          },
          {
            "name": "last_seen_to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000000
            },
            "description": "Unix seconds; inclusive upper bound on the effective last-seen time."
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ip",
                "source",
                "jail",
                "country",
                "asn",
                "organization",
                "active",
                "first_seen",
                "last_seen"
              ],
              "default": "ip"
            },
            "description": "Sort key. Empty country and organization values sort before non-empty values; a missing ASN sorts as 0."
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"],
              "default": "asc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidQuery"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "operationId": "listObservations",
        "tags": ["Public API"],
        "description": "Filter, sort and page observations. Ties are broken by ip, source and jail so that pages never duplicate or skip rows."
      }
    },
    "/v1/stats": {
      "get": {
        "summary": "Filtered counts and per-column aggregates",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
            }
          },
          {
            "name": "jail",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          {
            "name": "asn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          },
          {
            "name": "active",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["true", "false", "all"],
              "default": "true"
            },
            "description": "true: fresh active observations; false: inactive observations; all: full history including stale sources."
          },
          {
            "name": "stale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["true", "false"]
            },
            "description": "true only for sources whose last collection is older than the stale threshold."
          },
          {
            "name": "ip_prefix",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[0-9a-fA-F:.]+$"
            },
            "description": "Text prefix match on the canonical IP address."
          },
          {
            "name": "organization",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "Case-insensitive substring match on the organization name."
          },
          {
            "name": "first_seen_from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000000
            },
            "description": "Unix seconds; inclusive lower bound."
          },
          {
            "name": "first_seen_to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000000
            },
            "description": "Unix seconds; inclusive upper bound."
          },
          {
            "name": "last_seen_from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000000
            },
            "description": "Unix seconds; inclusive lower bound on the effective last-seen time."
          },
          {
            "name": "last_seen_to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000000
            },
            "description": "Unix seconds; inclusive upper bound on the effective last-seen time."
          },
          {
            "name": "group_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["country", "asn", "jail", "source"]
            },
            "description": "Return a single aggregate list grouped by this column."
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["observations", "ips", "value"],
              "default": "observations"
            },
            "description": "Sort the group_by list."
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"],
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidQuery"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "operationId": "getStats",
        "tags": ["Public API"],
        "description": "Apply the same filters as /v1/ips. Without group_by, return counts grouped by country, ASN, jail and source. With group_by, return a single sorted aggregate list."
      }
    },
    "/v1/sources": {
      "get": {
        "summary": "Public source and jail collection status",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidQuery"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "operationId": "listSources",
        "tags": ["Public API"]
      }
    },
    "/v1/feed.txt": {
      "get": {
        "summary": "Deduplicated IPs with the same filters, ordered by IP",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000,
              "default": 1000
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 2048
            },
            "description": "Opaque cursor from next_cursor or X-Next-Cursor. It is bound to the filters and sort; reuse with different conditions returns 400."
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
            }
          },
          {
            "name": "jail",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          {
            "name": "asn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          },
          {
            "name": "active",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["true", "false", "all"],
              "default": "true"
            },
            "description": "true: fresh active observations; false: inactive observations; all: full history including stale sources."
          },
          {
            "name": "stale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["true", "false"]
            },
            "description": "true only for sources whose last collection is older than the stale threshold."
          },
          {
            "name": "ip_prefix",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[0-9a-fA-F:.]+$"
            },
            "description": "Text prefix match on the canonical IP address."
          },
          {
            "name": "organization",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "Case-insensitive substring match on the organization name."

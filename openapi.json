            },
            "description": "Unix seconds; inclusive upper bound on the effective last-seen time."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful result",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "description": "Canonical IP addresses, one per line, with a trailing newline unless empty."
                }
              }
            },
            "headers": {
              "X-Truncated": {
                "description": "true if another page is available; otherwise false.",
                "schema": {
                  "type": "string",
                  "enum": ["true", "false"]
                }
              },
              "X-Next-Cursor": {
                "description": "Only present when X-Truncated is true. Pass as the next cursor query parameter.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidQuery"

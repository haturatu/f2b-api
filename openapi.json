  },
  "components": {
    "schemas": {
      "Observation": {
        "type": "object",
        "required": [
          "source",
          "jail",
          "ip",
          "first_seen",
          "last_seen",
          "active",
          "country",
          "asn",
          "organization",
          "network",
          "stale"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "jail": {
            "type": "string"
          },
          "ip": {
            "type": "string",
            "description": "Canonical public IPv4 or IPv6 address."
          },
          "first_seen": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp in seconds (collection time, not an exact BAN event time)."
          },
          "last_seen": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp in seconds (collection time, not an exact BAN event time)."
          },
          "active": {
            "type": "integer",
            "enum": [0, 1],
            "description": "1 when present in the latest snapshot; 0 when removed."
          },
          "country": {
            "type": ["string", "null"],
            "pattern": "^[A-Z]{2}$"
          },
          "asn": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 4294967295
          },
          "organization": {
            "type": ["string", "null"]
          },
          "network": {
            "type": ["string", "null"]
          },
          "stale": {
            "type": "integer",
            "enum": [0, 1],
            "description": "1 when the jail has not been collected within the freshness window (48 hours by default)."
          }
        },
        "additionalProperties": false
      },
      "Counts": {
        "type": "object",
        "required": ["observations", "ips"],
        "properties": {
          "observations": {
            "type": "integer",
            "minimum": 0
          },
          "ips": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "required": [
          "service",
          "version",
          "status",
          "classification",
          "html_reports"
        ],
        "properties": {
          "service": {
            "type": "string",
            "const": "f2b-api"
          },
          "version": {
            "type": "integer",
            "const": 1
          },
          "status": {
            "type": "string",
            "const": "ok"
          },
          "classification": {
            "type": "string"
          },
          "html_reports": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      },
      "Lookup": {
        "type": "object",
        "required": ["ip", "observations", "truncated"],
        "properties": {
          "ip": {
            "type": "string"
          },
          "observations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "maxItems": 1000
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ObservationPage": {
        "type": "object",
        "required": ["observations", "next_cursor"],
        "properties": {
          "observations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "maxItems": 500
          },
          "next_cursor": {
            "type": ["string", "null"],
            "description": "Opaque pagination cursor; retain the same filters on subsequent requests."
          }
        },
        "additionalProperties": false
      },
      "SourceState": {
        "type": "object",
        "required": [
          "source",
          "jail",
          "collected_at",
          "currently_banned",
          "total_banned",
          "public_ip_count",
          "stale"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "jail": {
            "type": "string"
          },
          "collected_at": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp in seconds (collection time, not an exact BAN event time)."
          },
          "currently_banned": {
            "type": "integer",
            "minimum": 0
          },
          "total_banned": {
            "type": "integer",
            "minimum": 0
          },
          "public_ip_count": {
            "type": "integer",
            "minimum": 0
          },
          "stale": {
            "type": "integer",
            "enum": [0, 1]
          }
        },
        "additionalProperties": false
      },
      "SourceList": {
        "type": "object",
        "required": ["sources"],
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceState"
            },
            "maxItems": 1000
          }
        },
        "additionalProperties": false
      },
      "Stats": {
        "type": "object",
        "required": ["active"],
        "properties": {
          "active": {
            "$ref": "#/components/schemas/Counts"
          },
          "countries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["value", "observations", "ips"],
              "properties": {
                "value": {
                  "type": ["string", "null"]
                },
                "observations": {
                  "type": "integer",
                  "minimum": 0
                },
                "ips": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "maxItems": 100
          },
          "asns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["value", "observations", "ips"],
              "properties": {
                "value": {
                  "type": ["integer", "null"]
                },
                "observations": {
                  "type": "integer",
